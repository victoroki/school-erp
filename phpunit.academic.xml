<?xml version="1.0" encoding="UTF-8"?>
<!--
    Isolated PHPUnit configuration for the Academic + Student Management audit.

    phpunit.xml forces DB_DATABASE=school_erp_test for every run, and that schema
    is shared with the Fee Management and Financial Management sessions. Two
    suites running RefreshDatabase against one schema destroy each other's data
    mid-run — migrate:fresh in one process wipes the tables the other is reading,
    which is what produced the earlier batch of spurious
    "Unknown column 'is_protected'" failures.

    This file is identical except for the database name, so an Academic/Student
    run cannot collide with another session. Everything else — APP_ENV, array
    caches/sessions, array mail, sync queue — is forced the same way for the same
    reasons documented in phpunit.xml.

    Usage: php vendor/bin/phpunit -c phpunit.academic.xml
    Never point DB_DATABASE at school_management_system: RefreshDatabase runs
    migrate:fresh.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <server name="CACHE_DRIVER" value="array" force="true"/>
        <!-- The whole point of this file: an isolated schema. -->
        <env name="DB_DATABASE" value="school_erp_academic_test" force="true"/>
        <server name="DB_DATABASE" value="school_erp_academic_test" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
