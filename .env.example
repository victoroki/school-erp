APP_NAME="School ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Secret token for the one-time school setup link (/setup/{token})
SETUP_TOKEN=

# Platform Owner account (you, the SaaS provider).
# Seeded automatically on `php artisan db:seed` with the exclusive Owner role:
# the only role that can activate paid modules and see audit trail + system logs.
SAAS_OWNER_EMAIL=
SAAS_OWNER_PASSWORD=
SAAS_OWNER_NAME="Platform Owner"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# IMPORTANT: Use 'database' in production so bulk SMS/email jobs don't block the
# HTTP request and don't time-out.  Run the worker with:
#   php artisan queue:work --sleep=3 --tries=3
# After switching run:
#   php artisan queue:table && php artisan migrate
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# ── Email setup ───────────────────────────────────────────────────────────────
# Option A – managed transactional email (recommended for production)
#   Providers: Mailgun, Postmark, SendGrid, Amazon SES
#   Set MAIL_MAILER to their driver (e.g. 'mailgun') and fill in the matching
#   config block in config/services.php, OR use SMTP credentials below.
# Option B – SMTP (Gmail, Outlook, any SMTP relay)
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your@gmail.com
#   MAIL_PASSWORD=your_app_password   (Gmail → Account → Security → App passwords)
#   MAIL_ENCRYPTION=tls
# After setting credentials, test with:
#   php artisan tinker → Mail::raw('test', fn($m) => $m->to('you@test.com'))
# ─────────────────────────────────────────────────────────────────────────────
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── SMS setup ─────────────────────────────────────────────────────────────────
# Preferred: configure via Admin → Communication → Provider Settings (stored
# encrypted in the database — no .env changes needed after first setup).
# The values below are ENV fallbacks used only when no DB config exists yet.
#
# Africa's Talking (https://account.africastalking.com):
#   1. Create an account and go to your application.
#   2. Copy the API Key and your registered Sender ID (shortcode or name).
#   3. Use 'sandbox' username for testing; your AT username for production.
# ─────────────────────────────────────────────────────────────────────────────
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=

# Sozuri SMS Provider (fallback if not configured via Provider Settings UI)
# Get credentials from https://sozuri.net:
#   1. Log in → Dashboard → API → copy API Key and Auth Key.
#   2. Create a Project and copy the Project ID (uuid or slug).
#   3. Register a Sender ID (shortcode or alphanumeric name).
# ─────────────────────────────────────────────────────────────────────────────
SOZURI_API_KEY=
SOZURI_PROJECT=
SOZURI_SENDER_ID=
SOZURI_MESSAGE_TYPE=transactional
SOZURI_AUTH_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
VITE_PUSHER_APP_CLUSTER=
